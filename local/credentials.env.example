# Copy this file to credentials.env (same folder, C:\AmazonFeed) and fill it in. Never share or upload credentials.env.
# Numbers follow the COLOURED order tabs, left to right: 1 = first coloured tab ... Antonio M = 7 (as on your workbook).
PROXY_URL=https://80b90de2b9ea8841eb77:YOUR_PROXY_PASSWORD@gw.dataimpulse.com:823
STICKY_BASE=10000
HEADLESS=1
MELA_USER_1=
MELA_PASS_1=
MELA_USER_2=
MELA_PASS_2=
MELA_USER_7=
MELA_PASS_7=

# Optional
# REGION_n = socal | vancouver | toronto   (default: blue tabs = socal, orange = vancouver, yellow = toronto)
# BROWSER=              (empty = built-in browser; chrome = the Google Chrome on this PC; chromium = new headless mode)
# SESSION_MINUTES=120   (how long the provider should keep the same IP, max 120; 0 = provider default)
# MAX_TRIES=8  WORKERS=4  FAST=1  HEADLESS=1   (HEADLESS=0 shows the browser windows)
